 },
 "252dc6f4f069": {
  "file": "252dc6f4f069.mp3",
  "who": "ben",
  "voice": "el:cjVigY5qzO86Huf0OWal:0.88",
  "dur": 1.37,
  "bytes": 8445,
  "text": "Thanks! Good luck out here."
 },
 "bba7208587ff": {
  "file": "bba7208587ff.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 2.62,
  "bytes": 15933,
  "text": "Listen to a trained canvasser open well."
 },
 "e4d10906c2c4": {
  "file": "e4d10906c2c4.mp3",
  "who": "tanya",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 2.23,
  "bytes": 13629,
  "text": "I am, yeah. Sure, I'll sign."
 },
 "a22cb1110258": {
  "file": "a22cb1110258.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 6.14,
  "bytes": 37101,
  "text": "A yes means the woman can sign, and now they're talking. The whole opener took about eight seconds."
 },
 "7c9ffe1b779b": {
  "file": "7c9ffe1b779b.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 2.93,
  "bytes": 17805,
  "text": "Here's one more. This time, the man isn't registered."
 },
 "642006920aa9": {
  "file": "642006920aa9.mp3",
  "who": "dwayne",
  "voice": "el:nPczCjzI2devNBz1zQrb:0.88",
  "dur": 0.82,
  "bytes": 5133,
  "text": "No, I'm not."
 },
 "0d3eabf555ba": {
  "file": "0d3eabf555ba.mp3",
  "who": "lena",
  "voice": "el:cgSgspJ2msm6clMCkdW9:0.88",
  "dur": 1.63,
  "bytes": 10029,
  "text": "No problem. Have a good one!",
  "take": 1
 },
 "69a606ba056f": {
  "file": "69a606ba056f.mp3",
  "who": "dwayne",
  "voice": "el:nPczCjzI2devNBz1zQrb:0.88",
  "dur": 0.79,
  "bytes": 4989,
  "text": "You too!"
 },
 "b8536707a7b1": {
  "file": "b8536707a7b1.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 6.34,
  "bytes": 38253,
  "text": "He can't sign, so she lets him go and turns to the next person. His no just saved her a minute."
 },
 "0aff3bb55b64": {
  "file": "0aff3bb55b64.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 9.07,
  "bytes": 54669,
  "text": "B is right. Passersby stop for someone who is standing and ready to meet them. Stand up, and step out in front of the table when you can."
 },
 "65964b661c29": {
  "file": "65964b661c29.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 7.82,
  "bytes": 47181,
  "text": "B is right. Stand where passersby walk, and never block the way. Anyone who wants to keep walking can."
 },
 "8785c624747a": {
  "file": "8785c624747a.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 4.37,
  "bytes": 26445,
  "text": "Here's a new canvasser. Listen for the one thing that goes wrong."
 },
 "17e0b2ddc6cb": {
  "file": "17e0b2ddc6cb.mp3",
  "who": "rico",
  "voice": "el:bIHbv24MWmeRgasZH58o:0.88",
  "dur": 8.93,
  "bytes": 53805,
  "text": "Hi! Do you have a minute? I'm collecting signatures for a ballot measure to keep libraries open later. Are you registered to vote in L.A. County?",
  "take": 3
 },
 "42e1c48a595a": {
  "file": "42e1c48a595a.mp3",
  "who": "hank",
  "voice": "el:pqHfZKP75CvOlQylNhV4:0.88",
  "dur": 1.7,
  "bytes": 10461,
  "text": "Sorry, I don't have a minute.",
  "take": 2
 },
 "677e90c7738c": {
  "file": "677e90c7738c.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 12.65,
  "bytes": 76125,
  "text": "About 5% stop, even for a good canvasser: one passerby in every 20. So say your opener to everyone who walks by. The no's are normal, and they're how you find the yeses."
 },
 "7ef34d1c59cc": {
  "file": "7ef34d1c59cc.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 6.26,
  "bytes": 37821,
  "text": "Your turn again. Here comes a woman with a tote bag. Say hi when she's close, and see if she'll stop."
 },
 "1d726f9a170f": {
  "file": "1d726f9a170f.mp3",
  "who": "soojin",
  "voice": "el:5u41aNhyCU6hXOcjPPv0:0.9",
  "dur": 1.03,
  "bytes": 6429,
  "text": "Yes, I am."
 },
 "dafe7089ed88": {
  "file": "dafe7089ed88.mp3",
  "who": "soojin",
  "voice": "el:5u41aNhyCU6hXOcjPPv0:0.9",
  "dur": 2.04,
  "bytes": 12477,
  "text": "Oh, that's nice. Sure, I'll sign."
 },
 "62e1c5f08d38": {
  "file": "62e1c5f08d38.mp3",
  "who": "soojin",
  "voice": "el:5u41aNhyCU6hXOcjPPv0:0.9",
  "dur": 2.09,
  "bytes": 12765,
  "text": "Oh, the library? What do you need?"
 },
 "8ebe89e55452": {
  "file": "8ebe89e55452.mp3",
  "who": "soojin",
  "voice": "el:5u41aNhyCU6hXOcjPPv0:0.9",
  "dur": 2.42,
  "bytes": 14781,
  "text": "Oh, sorry, I'm busy. Have a good day."
 },
 "7ec64a2a70c2": {
