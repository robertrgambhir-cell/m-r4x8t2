  "file": "2f3aa5ce998a.mp3",
  "who": "rico",
  "voice": "el:bIHbv24MWmeRgasZH58o:0.88",
  "dur": 12.31,
  "bytes": 74109,
  "text": "Here are this month's top funders. It funds longer evening and weekend hours at branch libraries, and it's paid for by a new state tax on digital ad sales. Have you signed this one already?"
 },
