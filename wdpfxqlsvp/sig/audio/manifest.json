 "7e698885b795": {
  "file": "7e698885b795.mp3",
  "who": "tanya",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 1.9,
  "bytes": 11613,
  "text": "I'd rather decide for myself."
 },
 "a36b830da430": {
  "file": "a36b830da430.mp3",
  "who": "tanya",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 1.25,
  "bytes": 7725,
  "text": "Okay, bye now."
 },
 "7eda34bc59ed": {
  "file": "7eda34bc59ed.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 1.46,
  "bytes": 9021,
  "text": "Now listen to Lena."
 },
 "b1356db407c5": {
  "file": "b1356db407c5.mp3",
  "who": "bob",
  "voice": "el:CwhRBWXzGAHq8TQ4Fs17:0.88",
  "dur": 2.21,
  "bytes": 13485,
  "text": "I'm registered. What've you got?"
 },
 "ee450dd94e0d": {
  "file": "ee450dd94e0d.mp3",
  "who": "lena",
  "voice": "el:cgSgspJ2msm6clMCkdW9:0.88",
  "dur": 4.99,
  "bytes": 30189,
  "text": "Thanks for stopping. I'm paid to gather signatures, and here are this month's top funders."
 },
 "246d0d47a8cf": {
  "file": "246d0d47a8cf.mp3",
  "who": "lena",
  "voice": "el:cgSgspJ2msm6clMCkdW9:0.88",
  "dur": 9.62,
  "bytes": 57981,
  "text": "It funds longer evening and weekend hours at branch libraries, and it's paid for by a new state tax on digital ad sales. Have you signed this one already?"
 },
 "4403593beb8c": {
  "file": "4403593beb8c.mp3",
  "who": "bob",
  "voice": "el:CwhRBWXzGAHq8TQ4Fs17:0.88",
  "dur": 1.46,
  "bytes": 9021,
  "text": "No, first I've heard of it."
 },
 "37c517084f6a": {
  "file": "37c517084f6a.mp3",
  "who": "bob",
  "voice": "el:CwhRBWXzGAHq8TQ4Fs17:0.88",
  "dur": 0.84,
  "bytes": 5277,
  "text": "All right."
 },
 "4b8908581486": {
  "file": "4b8908581486.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 9.1,
  "bytes": 54813,
  "text": "First, she said she's paid and showed the top funders before the petition left her hand. The law requires both, even if nobody asks."
 },
 "a53fa3002e0a": {
  "file": "a53fa3002e0a.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 3.55,
  "bytes": 21549,
  "text": "Second, she said what the measure does and how it's paid for."
 },
 "cbc54bb19ff7": {
  "file": "cbc54bb19ff7.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 6.12,
  "bytes": 36957,
  "text": "Third, she asked if he signed already, because one double can cost about 1,000 signatures."
 },
 "1fe768754586": {
  "file": "1fe768754586.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 6.14,
  "bytes": 37101,
  "text": "Fourth, she asked for the signature and left the choice with him, because people sign when they're asked."
 },
 "f473b84db28e": {
  "file": "f473b84db28e.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 7.13,
  "bytes": 43005,
  "text": "C is right. Nothing in the measure says libraries are closing, and nobody can promise what a tax will cost."
 },
 "75d33bb8bfa1": {
  "file": "75d33bb8bfa1.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 3.86,
  "bytes": 23421,
  "text": "B is right. A sheet is only good for the month printed on it."
 },
 "b6b9f73bd477": {
  "file": "b6b9f73bd477.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 5.38,
  "bytes": 32493,
  "text": "A is right. A second signature never helps, and it can cost the drive about 1,000."
 },
 "fdafeb49a13a": {
  "file": "fdafeb49a13a.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 2.57,
  "bytes": 15645,
  "text": "Here's Rico again. One part is missing."
 },
 "2f3aa5ce998a": {
  "file": "2f3aa5ce998a.mp3",
  "who": "rico",
  "voice": "el:bIHbv24MWmeRgasZH58o:0.88",
  "dur": 12.31,
  "bytes": 74109,
  "text": "Here are this month's top funders. It funds longer evening and weekend hours at branch libraries, and it's paid for by a new state tax on digital ad sales. Have you signed this one already?"
 },
 "36f1c1fd36a6": {
  "file": "36f1c1fd36a6.mp3",
  "who": "soojin",
  "voice": "el:hpp4J3VqNfWAUOO0d1Us:0.88",
  "dur": 1.08,
  "bytes": 6717,
  "text": "No, I haven't."
 },
 "b1d1ac302ce1": {
  "file": "b1d1ac302ce1.mp3",
  "who": "rico",
  "voice": "el:bIHbv24MWmeRgasZH58o:0.88",
  "dur": 3.5,
  "bytes": 21261,
  "text": "Here's the petition. Will you sign to put it on the ballot?"
 },
 "69714b272e0f": {
  "file": "69714b272e0f.mp3",
  "who": "soojin",
  "voice": "el:hpp4J3VqNfWAUOO0d1Us:0.88",
  "dur": 1.8,
  "bytes": 11037,
  "text": "Are you with the library, dear?",
  "take": 1
 },
 "6871348ad7d5": {
  "file": "6871348ad7d5.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 2.42,
  "bytes": 14781,
  "text": "Now do the whole stop, starting from hello.",
  "take": 2
 },
 "952d48bbf145": {
  "file": "952d48bbf145.mp3",
  "who": "marisol",
  "voice": "el:EXAVITQu4vr4xnSDxMaL:0.88",
  "dur": 2.52,
  "bytes": 15357,
  "text": "Yes, I'm registered. I've got a minute."
 },
 "64f750562525": {
  "file": "64f750562525.mp3",
  "who": "marisol",
  "voice": "el:EXAVITQu4vr4xnSDxMaL:0.88",
  "dur": 1.68,
  "bytes": 10317,
  "text": "Hi. What's this one for?"
 },
 "f8d6297025be": {
  "file": "f8d6297025be.mp3",
  "who": "marisol",
  "voice": "el:EXAVITQu4vr4xnSDxMaL:0.88",
  "dur": 1.73,
  "bytes": 10605,
  "text": "No, I haven't signed it."
 },
 "c3f18927c1e6": {
  "file": "c3f18927c1e6.mp3",
  "who": "marisol",
  "voice": "el:EXAVITQu4vr4xnSDxMaL:0.88",
  "dur": 1.87,
  "bytes": 11469,
  "text": "Sure. Where do I sign?"
 },
 "46e2b746c263": {
  "file": "46e2b746c263.mp3",
  "who": "marisol",
  "voice": "el:EXAVITQu4vr4xnSDxMaL:0.88",
  "dur": 1.56,
  "bytes": 9597,
  "text": "So, what do you need from me?"
 },
 "1c17457006e3": {
  "file": "1c17457006e3.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 2.4,
  "bytes": 14637,
  "text": "A man has stopped too. Try it with him."
 },
 "f483e1541839": {
  "file": "f483e1541839.mp3",
  "who": "luis",
  "voice": "el:TX3LPaxmHKxFdv7VOQHJ:0.88",
  "dur": 1.54,
  "bytes": 9453,
  "text": "Hey. What's this one for?"
 },
 "aaafb280097c": {
  "file": "aaafb280097c.mp3",
  "who": "luis",
  "voice": "el:TX3LPaxmHKxFdv7VOQHJ:0.88",
  "dur": 4.92,
  "bytes": 29757,
  "text": "Oh, the library one. I think I signed that at the farmers market last week."
 },
 "93db68a61e30": {
  "file": "93db68a61e30.mp3",
  "who": "luis",
  "voice": "el:TX3LPaxmHKxFdv7VOQHJ:0.88",
  "dur": 1.78,
  "bytes": 10893,
  "text": "Cool. Good luck out here."
 },
 "8e79d9999fcb": {
  "file": "8e79d9999fcb.mp3",
  "who": "luis",
  "voice": "el:TX3LPaxmHKxFdv7VOQHJ:0.88",
  "dur": 2.69,
  "bytes": 16365,
  "text": "Are you sure? I'm pretty sure I signed it."
 },
 "fb5ec40d4906": {
  "file": "fb5ec40d4906.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 4.18,
  "bytes": 25293,
  "text": "Saying you're paid and showing the funders is a must. Try it once more."
 },
 "a4b8fd8176af": {
  "file": "a4b8fd8176af.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 3.22,
  "bytes": 19533,
  "text": "Telling both halves is a must. Try it once more."
 },
 "3761314a81bc": {
  "file": "3761314a81bc.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 4.3,
  "bytes": 26013,
  "text": "A woman said yes. She's at your board with a grocery bag in each hand."
 },
 "608a922e82d3": {
  "file": "608a922e82d3.mp3",
  "who": "anika",
  "voice": "el:EXAVITQu4vr4xnSDxMaL:0.88",
  "dur": 3.62,
  "bytes": 21981,
  "text": "Can you just fill in my address for me? My hands are full."
 },
 "bfc05800c0bc": {
  "file": "bfc05800c0bc.mp3",
  "who": "anika",
  "voice": "el:EXAVITQu4vr4xnSDxMaL:0.88",
  "dur": 2.06,
  "bytes": 12621,
  "text": "Oh, okay. Hold this for a second?"
 },
 "fea916bb295d": {
  "file": "fea916bb295d.mp3",
  "who": "anika",
  "voice": "el:EXAVITQu4vr4xnSDxMaL:0.88",
  "dur": 2.52,
  "bytes": 15357,
  "text": "Thanks! It's 88 Hill Street."
 },
 "a51af811246c": {
  "file": "a51af811246c.mp3",
  "who": "anika",
  "voice": "el:EXAVITQu4vr4xnSDxMaL:0.88",
  "dur": 1.75,
  "bytes": 10749,
  "text": "So can you write it for me?"
 },
 "eaf6ede40ae8": {
  "file": "eaf6ede40ae8.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 3.17,
  "bytes": 19245,
  "text": "Watch the line as Lena helps an older man who said yes."
 },
 "a4be3da6eb25": {
  "file": "a4be3da6eb25.mp3",
  "who": "lena",
  "voice": "el:cgSgspJ2msm6clMCkdW9:0.88",
  "dur": 4.9,
  "bytes": 29613,
  "text": "Print your name right here. Then sign, and then write the address where you're registered to vote."
 },
 "be4c78d6baf5": {
  "file": "be4c78d6baf5.mp3",
  "who": "bob",
  "voice": "el:CwhRBWXzGAHq8TQ4Fs17:0.88",
  "dur": 3.53,
  "bytes": 21405,
  "text": "Can you write it for me? My handwriting's terrible."
 },
 "d24621070790": {
  "file": "d24621070790.mp3",
  "who": "lena",
  "voice": "el:cgSgspJ2msm6clMCkdW9:0.88",
  "dur": 4.39,
  "bytes": 26589,
  "text": "It has to be in your handwriting. Terrible is fine. Take your time."
 },
 "228467b00ce0": {
  "file": "228467b00ce0.mp3",
  "who": "lena",
  "voice": "el:cgSgspJ2msm6clMCkdW9:0.88",
  "dur": 3.22,
  "bytes": 19533,
  "text": "Bob, your city and zip are still blank. Could you add them?"
 },
 "7f964cab7634": {
  "file": "7f964cab7634.mp3",
  "who": "bob",
  "voice": "el:CwhRBWXzGAHq8TQ4Fs17:0.88",
  "dur": 3.74,
  "bytes": 22701,
  "text": "It's Los Angeles, nine oh oh two four. There you go."
 },
 "dc8d6fa44c83": {
  "file": "dc8d6fa44c83.mp3",
  "who": "lena",
  "voice": "el:cgSgspJ2msm6clMCkdW9:0.88",
  "dur": 1.7,
  "bytes": 10461,
  "text": "That's a good line. Thank you!"
 },
 "bdc771d5f32f": {
  "file": "bdc771d5f32f.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 2.52,
  "bytes": 15357,
  "text": "First, she asked him to print his name."
 },
 "420bed238368": {
  "file": "420bed238368.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 3.55,
  "bytes": 21549,
  "text": "Second, she asked for the address where he's registered to vote."
 },
 "45eaecbef161": {
  "file": "45eaecbef161.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 4.85,
  "bytes": 29325,
  "text": "Third, she kept the pen in his hand, because the signer writes every word."
 },
 "457f5f2f949a": {
  "file": "457f5f2f949a.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 3.53,
  "bytes": 21405,
  "text": "Fourth, she looked at the line before he left and caught the gap."
 },
 "d1c2f880ad8c": {
  "file": "d1c2f880ad8c.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 7.42,
  "bytes": 44733,
  "text": "Now it's your turn to look at four lines. Tap the box that will get each line thrown out, or tap Good to go."
 },
 "434227eb00cf": {
  "file": "434227eb00cf.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 8.3,
  "bytes": 50061,
  "text": "C is right. Never use white-out, and never write on a signer's line. A fresh line in the signer's own writing is the fix."
 },
 "3ea2bb80a82e": {
  "file": "3ea2bb80a82e.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 14.42,
  "bytes": 86781,
  "text": "C is right. His line needs his current address, and it must match his voter record. He can update his registration at register to vote dot C A dot gov, then sign. Never promise his line will count."
 },
 "27bc6cc8939c": {
  "file": "27bc6cc8939c.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 14.09,
  "bytes": 84765,
  "text": "Every sheet has one more line, and it's yours: the Declaration of Circulator. It says you gathered these signatures, watched each one being written and showed every signer this month's top funders."
 },
 "1f965027929a": {
  "file": "1f965027929a.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 16.27,
  "bytes": 97869,
  "text": "The blank one and the one your lead filled in each cost the whole sheet. After the last signature, write your name, your address and the first and last days you gathered on that sheet. Then sign and date it, all in your own writing."
 },
 "a23bfd78aeaf": {
  "file": "a23bfd78aeaf.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 9.05,
  "bytes": 54525,
  "text": "A woman with her daughter is registered and ready to sign. Before the pen moves, ask if she's signed this one already. Then walk her through the line."
 },
 "84ce22487481": {
  "file": "84ce22487481.mp3",
  "who": "tanya",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 4.46,
  "bytes": 27021,
  "text": "Can you fill in the address for me, though? I've got my hands full with this one."
 },
 "76102c937c9e": {
  "file": "76102c937c9e.mp3",
  "who": "tanya",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 3.98,
  "bytes": 24141,
  "text": "Can you fill in the address for me? I've got my hands full with this one.",
  "take": 2
 },
 "e9552a2e5a34": {
  "file": "e9552a2e5a34.mp3",
  "who": "tanya",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 1.8,
  "bytes": 11037,
  "text": "Okay. Hang on, sweetie."
 },
 "f49ccec5a84a": {
  "file": "f49ccec5a84a.mp3",
  "who": "tanya",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 0.82,
  "bytes": 5133,
  "text": "All set?"
 },
 "eb763263f20e": {
  "file": "eb763263f20e.mp3",
  "who": "tanya",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 1.7,
  "bytes": 10461,
  "text": "Oh! I skipped it."
 },
 "a2c1035880d7": {
  "file": "a2c1035880d7.mp3",
  "who": "tanya",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 0.94,
  "bytes": 5853,
  "text": "There you go."
 },
 "3a40d6a2f1c3": {
  "file": "3a40d6a2f1c3.mp3",
  "who": "tanya",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 1.13,
  "bytes": 7005,
  "text": "Great, thanks!"
 },
 "845f9061ced8": {
  "file": "845f9061ced8.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 4.99,
  "bytes": 30189,
  "text": "The signer writes every word on their line, and that's a must. Try it once more."
 },
 "d7838c0eb213": {
  "file": "d7838c0eb213.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 6,
  "bytes": 36237,
  "text": "An older man stopped, and you told him what the measure does. He's holding the pen, and he has a question."
 },
 "12419f032e5b": {
  "file": "12419f032e5b.mp3",
  "who": "hank",
  "voice": "el:pqHfZKP75CvOlQylNhV4:0.88",
  "dur": 2.21,
  "bytes": 13485,
  "text": "Hold on. Is this a new tax?"
 },
 "6cad60dd6ac0": {
  "file": "6cad60dd6ac0.mp3",
  "who": "hank",
  "voice": "el:pqHfZKP75CvOlQylNhV4:0.88",
  "dur": 3.12,
  "bytes": 18957,
  "text": "Huh. Okay. At least you told me straight."
 },
 "03322307cca9": {
  "file": "03322307cca9.mp3",
  "who": "hank",
  "voice": "el:pqHfZKP75CvOlQylNhV4:0.88",
  "dur": 1.73,
  "bytes": 10605,
  "text": "Says here it's a tax."
 },
 "e4d9c12cca74": {
  "file": "e4d9c12cca74.mp3",
  "who": "hank",
  "voice": "el:pqHfZKP75CvOlQylNhV4:0.88",
  "dur": 0.48,
  "bytes": 3117,
  "text": "Hi."
 },
 "bf1caff193c3": {
  "file": "bf1caff193c3.mp3",
  "who": "hank",
  "voice": "el:pqHfZKP75CvOlQylNhV4:0.88",
  "dur": 1.2,
  "bytes": 7437,
  "text": "I'm good, thanks."
 },
 "fe2dac646a72": {
  "file": "fe2dac646a72.mp3",
  "who": "hank",
  "voice": "el:pqHfZKP75CvOlQylNhV4:0.88",
  "dur": 1.87,
  "bytes": 11469,
  "text": "I'd rather decide for myself."
 },
 "e1736ee5c7c8": {
  "file": "e1736ee5c7c8.mp3",
  "who": "hank",
  "voice": "el:pqHfZKP75CvOlQylNhV4:0.88",
  "dur": 1.49,
  "bytes": 9165,
  "text": "Okay, bye now."
 },
 "44dab198926e": {
  "file": "44dab198926e.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 2.71,
  "bytes": 16509,
  "text": "Listen to Lena with a woman who has stopped.",
  "take": 3
 },
 "5540dead7379": {
  "file": "5540dead7379.mp3",
  "who": "joan",
  "voice": "el:hpp4J3VqNfWAUOO0d1Us:0.88",
  "dur": 1.82,
  "bytes": 11181,
  "text": "Is this going to raise taxes?"
 },
 "45654e06e703": {
  "file": "45654e06e703.mp3",
  "who": "lena",
  "voice": "el:cgSgspJ2msm6clMCkdW9:0.88",
  "dur": 10.25,
  "bytes": 61725,
  "text": "Yes. It's a new state tax on digital advertising sales. That's how it pays for the longer hours. It's printed right here in the summary. Take a look."
 },
 "727d121bc273": {
  "file": "727d121bc273.mp3",
  "who": "lena",
  "voice": "el:cgSgspJ2msm6clMCkdW9:0.88",
  "dur": 0.89,
  "bytes": 5565,
  "text": "Want to sign?"
 },
 "e1cd69f8fe67": {
  "file": "e1cd69f8fe67.mp3",
  "who": "joan",
  "voice": "el:hpp4J3VqNfWAUOO0d1Us:0.88",
  "dur": 1.97,
  "bytes": 12045,
  "text": "Not today. I buy a lot of ads."
 },
 "62ddb675147e": {
  "file": "62ddb675147e.mp3",
  "who": "lena",
  "voice": "el:cgSgspJ2msm6clMCkdW9:0.88",
  "dur": 3.1,
  "bytes": 18813,
  "text": "No problem. Thanks for stopping. Have a good one."
 },
 "d0af6efba162": {
  "file": "d0af6efba162.mp3",
  "who": "joan",
  "voice": "el:hpp4J3VqNfWAUOO0d1Us:0.88",
  "dur": 2.4,
  "bytes": 14637,
  "text": "You too. Thanks for being straight with me."
 },
 "86bd6dd36a96": {
  "file": "86bd6dd36a96.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 3.22,
  "bytes": 19533,
  "text": "First, she answered the question, and the answer was true."
 },
 "977c7e9e5089": {
  "file": "977c7e9e5089.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 2.76,
  "bytes": 16797,
  "text": "Second, she showed her where the tax is printed."
 },
 "d4670c08188c": {
  "file": "d4670c08188c.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 1.92,
  "bytes": 11757,
  "text": "Third, she asked once more."
 },
 "d84b5cc0ccd1": {
  "file": "d84b5cc0ccd1.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 4.56,
  "bytes": 27597,
  "text": "Fourth, the woman said no, and Lena let her go with a thank-you."
 },
 "62ebd9eda81d": {
  "file": "62ebd9eda81d.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 7.44,
  "bytes": 44877,
  "text": "Some people sign after a straight answer and some don't. Either way Lena is free for the next person in twenty seconds."
 },
 "1df2ae6ab454": {
  "file": "1df2ae6ab454.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 4.68,
  "bytes": 28317,
  "text": "You'll hear these four questions this week. Tap the straight answer to each one."
 },
 "314b16e7e9e7": {
  "file": "314b16e7e9e7.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 4.3,
  "bytes": 26013,
  "text": "B is right. You already said you're paid once, so say it again."
 },
 "48a794d13ca0": {
  "file": "48a794d13ca0.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 5.09,
  "bytes": 30765,
  "text": "A is right. A signature helps put the question on the ballot, and it isn't a vote."
 },
 "46acc9b031fa": {
  "file": "46acc9b031fa.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 8.64,
  "bytes": 52077,
  "text": "B is right. Never guess. 'I don't know, but it's printed right here' is a whole answer, and you can ask your lead later."
 },
 "8569c3b22682": {
  "file": "8569c3b22682.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 6.19,
  "bytes": 37389,
  "text": "A is right. Giving anything of value for a signature is against the law, even something small."
 },
 "aee02a8a19fb": {
  "file": "aee02a8a19fb.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 3.6,
  "bytes": 21837,
  "text": "This is Rico's last turn. Listen for the part that goes wrong."
 },
 "bab27c60d991": {
  "file": "bab27c60d991.mp3",
  "who": "karim",
  "voice": "el:pNInz6obpgDQGcFmaJgB:0.88",
  "dur": 1.46,
  "bytes": 9021,
  "text": "Is this a tax thing?"
 },
 "419a5b5eaca1": {
  "file": "419a5b5eaca1.mp3",
  "who": "rico",
  "voice": "el:bIHbv24MWmeRgasZH58o:0.88",
  "dur": 6.17,
  "bytes": 37245,
  "text": "Don't worry about that part. It's all about keeping libraries open later. It's right here. Want to sign?"
 },
 "205cc4205f64": {
  "file": "205cc4205f64.mp3",
  "who": "karim",
  "voice": "el:pNInz6obpgDQGcFmaJgB:0.88",
  "dur": 1.8,
  "bytes": 11037,
  "text": "Hmm. I'll pass."
 },
 "4679d985eef9": {
  "file": "4679d985eef9.mp3",
  "who": "rico",
  "voice": "el:bIHbv24MWmeRgasZH58o:0.88",
  "dur": 1.63,
  "bytes": 10029,
  "text": "No problem. Have a good one.",
  "take": 3
 },
 "a4a780df9fb9": {
  "file": "a4a780df9fb9.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 8.47,
  "bytes": 51069,
  "text": "This is your last try. Two people will ask two questions. Answer straight, show them the page, ask once and let a no go."
 },
 "38dd324ee1c6": {
  "file": "38dd324ee1c6.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 3.91,
  "bytes": 23709,
  "text": "A man with a coffee has stopped, and you've told him what the measure does."
 },
 "69c69903a217": {
  "file": "69c69903a217.mp3",
  "who": "ben",
  "voice": "el:cjVigY5qzO86Huf0OWal:0.88",
  "dur": 1.56,
  "bytes": 9597,
  "text": "Wait. Are you a volunteer?",
  "take": 2
 },
 "c7332173d537": {
  "file": "c7332173d537.mp3",
  "who": "ben",
  "voice": "el:cjVigY5qzO86Huf0OWal:0.88",
  "dur": 1.92,
  "bytes": 11757,
  "text": "Fair enough. Thanks for telling me."
 },
 "8f250d52f639": {
  "file": "8f250d52f639.mp3",
  "who": "ben",
  "voice": "el:cjVigY5qzO86Huf0OWal:0.88",
  "dur": 2.33,
  "bytes": 14205,
  "text": "Sorry, but are you a volunteer or not?",
  "take": 1
 },
 "b9a2229667bb": {
  "file": "b9a2229667bb.mp3",
  "who": "ben",
  "voice": "el:cjVigY5qzO86Huf0OWal:0.88",
  "dur": 1.06,
  "bytes": 6573,
  "text": "Sure, I'll sign."
 },
 "af98d2cd11f0": {
  "file": "af98d2cd11f0.mp3",
  "who": "ben",
  "voice": "el:cjVigY5qzO86Huf0OWal:0.88",
  "dur": 2.54,
  "bytes": 15501,
  "text": "Okay. Is there something you want me to sign?",
  "take": 1
 },
 "ffc072aedcad": {
  "file": "ffc072aedcad.mp3",
  "who": "pat",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 3.14,
  "bytes": 19101,
  "text": "Before I sign anything, is this a new tax?"
 },
 "0afd7a27c245": {
  "file": "0afd7a27c245.mp3",
  "who": "pat",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 1.58,
  "bytes": 9741,
  "text": "So what do you want me to do?"
 },
 "276b0d49e447": {
  "file": "276b0d49e447.mp3",
  "who": "pat",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 3.43,
  "bytes": 20829,
  "text": "That isn't what I asked. Is it a new tax or not?"
 },
 "48b19a77bc5d": {
  "file": "48b19a77bc5d.mp3",
  "who": "pat",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 1.85,
  "bytes": 11325,
  "text": "I appreciate the straight answer."
 },
 "e4546c805cbb": {
  "file": "e4546c805cbb.mp3",
  "who": "pat",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 2.59,
  "bytes": 15789,
  "text": "I don't sign anything with a new tax in it.",
  "take": 5
 },
 "4c619cc9ccbe": {
  "file": "4c619cc9ccbe.mp3",
  "who": "pat",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 3.65,
  "bytes": 22125,
  "text": "You're the first one out here who just told me. Good luck."
 },
 "b903c33bf34a": {
  "file": "b903c33bf34a.mp3",
  "who": "pat",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 1.34,
  "bytes": 8301,
  "text": "Okay. Bye now."
 },
 "c7371daba941": {
  "file": "c7371daba941.mp3",
  "who": "pat",
  "voice": "el:XrExE9yKIg1WjnnlVkGX:0.88",
  "dur": 1.63,
  "bytes": 10029,
  "text": "Like I said, no thanks."
 },
 "989d2e20eb9a": {
  "file": "989d2e20eb9a.mp3",
  "who": "coach",
  "voice": "el:bRlp5mUWs01wX4H4oW4X:0.9",
  "dur": 3.24,
  "bytes": 19677,
  "text": "A straight, true answer is a must. Try it once more."
 }
